<%@ page pageEncoding="UTF-8" %>
<%
    logica.DTAutenticacion usuarioMovil =
            (logica.DTAutenticacion) session.getAttribute("usuario");
%>
<header class="movil-topbar">
    <div class="movil-topbar-fila">
        <a class="movil-marca" href="${pageContext.request.contextPath}/movil/inicio">
            ed<span>EXT</span>
        </a>

        <% if (usuarioMovil != null) { %>
            <span class="movil-saludo-top">
                Bienvenido, <strong><%= escapar(usuarioMovil.getNombre()) %></strong>
            </span>
        <% } %>

        <button type="button"
                class="movil-hamburguesa"
                aria-label="Abrir menú de navegación"
                aria-expanded="false"
                aria-controls="movilMenuNav"
                onclick="var m = document.getElementById('movilMenuNav'); var abierto = m.classList.toggle('abierto'); this.setAttribute('aria-expanded', abierto);">
            &#9776;
        </button>
    </div>

    <nav id="movilMenuNav" class="movil-menu" aria-label="Menú móvil">
        <% if (usuarioMovil != null) { %>
            <div class="movil-menu-usuario">
                <%= escapar(usuarioMovil.getNombre()) %> (@<%= escapar(usuarioMovil.getNick()) %>) &bull; Estudiante
            </div>
        <% } %>
        <a href="${pageContext.request.contextPath}/movil/inicio"
           class="<%= "inicio".equals(paginaActiva) ? "activo" : "" %>">Inicio</a>
        <a href="${pageContext.request.contextPath}/movil/cursos"
           class="<%= "cursos".equals(paginaActiva) ? "activo" : "" %>">Ver Cursos</a>
        <a href="${pageContext.request.contextPath}/movil/ediciones"
           class="<%= "ediciones".equals(paginaActiva) ? "activo" : "" %>">Ver Ediciones</a>
        <a href="${pageContext.request.contextPath}/movil/logout" class="salir">Salir</a>
    </nav>
</header>