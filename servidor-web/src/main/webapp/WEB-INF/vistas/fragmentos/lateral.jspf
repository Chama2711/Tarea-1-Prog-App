<%@ page pageEncoding="UTF-8" %>
<aside class="navegacion-lateral" aria-label="Explorar edEXT">
    <% if (usuarioSesion != null) { %>
    <nav aria-label="Mi cuenta">
        <a href="${pageContext.request.contextPath}/usuario?nick=<%= parametro(usuarioSesion.getNick()) %>">Mi perfil</a>
        <% if (usuarioSesion.getRol() == DTAutenticacion.Rol.ESTUDIANTE) { %>
        <a href="${pageContext.request.contextPath}/usuario?nick=<%= parametro(usuarioSesion.getNick()) %>#perfil-ediciones">Mis inscripciones</a>
        <% } else { %>
        <a href="${pageContext.request.contextPath}/alta-curso">Crear curso</a>
        <a href="${pageContext.request.contextPath}/alta-edicion-curso">Crear edición</a>
        <a href="${pageContext.request.contextPath}/alta-programa">Crear programa</a>
        <a href="${pageContext.request.contextPath}/seleccion-estudiantes">Seleccionar estudiantes</a>
        <a href="${pageContext.request.contextPath}/usuario?nick=<%= parametro(usuarioSesion.getNick()) %>#perfil-ediciones">Mis ediciones</a>
        <a href="${pageContext.request.contextPath}/listar-aceptados">Estudiantes aceptados</a>
        <a href="${pageContext.request.contextPath}/ingresar-evaluaciones">Ingresar evaluaciones</a>
        <% } %>
    </nav>
    <% } %>
    <nav aria-labelledby="nav-institutos">
        <h2 id="nav-institutos">Institutos</h2>
        <% if (request.getAttribute("errorInstitutos") != null) { %>
        <p role="alert"><%= escapar(request.getAttribute("errorInstitutos")) %></p>
        <% } %>
        <% if (request.getAttribute("navInstitutos") != null) {
            for (String item : (java.util.List<String>) request.getAttribute("navInstitutos")) { %>
        <a href="${pageContext.request.contextPath}/busqueda?instituto=<%= parametro(item) %>" <%= item.equals(request.getParameter("instituto")) ? "aria-current=\"true\"" : "" %>><%= escapar(item) %></a>
        <% } } %>
    </nav>
    <nav aria-labelledby="nav-categorias">
        <h2 id="nav-categorias">Categorías</h2>
        <% if (request.getAttribute("errorCategorias") != null) { %>
        <p role="alert"><%= escapar(request.getAttribute("errorCategorias")) %></p>
        <% } %>
        <% if (request.getAttribute("navCategorias") != null) {
            for (String item : (java.util.List<String>) request.getAttribute("navCategorias")) { %>
        <a href="${pageContext.request.contextPath}/busqueda?categoria=<%= parametro(item) %>" <%= item.equals(request.getParameter("categoria")) ? "aria-current=\"true\"" : "" %>><%= escapar(item) %></a>
        <% } } %>
    </nav>
</aside>
